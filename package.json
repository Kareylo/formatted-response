{
  "name": "formatted-response",
  "version": "2.0.0",
  "description": "Create formatted, consistently-shaped JSON responses — synchronously or as promises. Zero runtime dependencies.",
  "keywords": [
    "response",
    "formatted",
    "formatted-response",
    "json",
    "status",
    "promise",
    "api",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Corentin Nazé"
  },
  "homepage": "https://github.com/kareylo/formatted-response#readme",
  "bugs": {
    "url": "https://github.com/kareylo/formatted-response/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kareylo/formatted-response.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck.only",
    "test:coverage": "vitest run --coverage",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "check:package": "publint --strict --pack npm && attw --pack . --profile node16 --ignore-rules false-export-default no-resolution",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:package && npm run test:dist",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
